{
  "name": "Advanced Data Engineering lab",
  // One small Alpine container (see Dockerfile), no Docker inside. Creating the codespace installs only the host
  // Python; each lab starts its services with scripts/codespace.sh up [cdc|monitoring|orchestration], which
  // installs them the first time.
  "build": { "dockerfile": "Dockerfile" },
  // an init process as PID 1 reaps the services' child processes when they stop
  "init": true,
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "uv sync --locked",
  "forwardPorts": [3030, 8080, 8082, 9001, 8081, 3000, 9090, 4200],
  "portsAttributes": {
    "3030": {"label": "Lab control panel"},
    "8080": {"label": "Kafka UI"},
    "8082": {"label": "Spark master UI"},
    "9001": {"label": "MinIO console"},
    "8081": {"label": "Schema Registry"},
    "3000": {"label": "Grafana (Lab 10)"},
    "9090": {"label": "Prometheus (Lab 10)"},
    "4200": {"label": "Prefect UI (Lab 11)"}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
