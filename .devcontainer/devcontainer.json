{
  "name": "Advanced Data Engineering lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  // Prebuilds cache this step: pull the core images and build the Spark image only.
  // Other labs pull their extra images on `make up LAB=NN`.
  "onCreateCommand": "make pull",
  "postCreateCommand": "make setup",
  "forwardPorts": [8080, 8082, 9001, 8081, 3000, 9090, 4200],
  "portsAttributes": {
    "8080": {"label": "Kafka UI"},
    "8082": {"label": "Spark master UI"},
    "9001": {"label": "MinIO console"},
    "8081": {"label": "Schema Registry"},
    "3000": {"label": "Grafana (Lab 10)"},
    "9090": {"label": "Prometheus (Lab 10)"},
    "4200": {"label": "Prefect UI (Lab 11)"}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
