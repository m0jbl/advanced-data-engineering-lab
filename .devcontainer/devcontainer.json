{
  "name": "Advanced Data Engineering lab",
  // Alpine minirootfs with Docker, Compose and uv (see Dockerfile). Creating the codespace pulls no lab
  // images and starts no containers: each trainee starts the stack a lab needs, when the lab starts.
  "build": { "dockerfile": "Dockerfile" },
  "privileged": true,
  "overrideCommand": false,
  // Docker's own storage lives on a volume: overlay2 does not work on top of the container's overlay filesystem
  "mounts": ["source=dind-var-lib-docker-${devcontainerId},target=/var/lib/docker,type=volume"],
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "uv sync --locked",
  "forwardPorts": [8080, 8082, 9001, 8081, 3000, 9090, 4200],
  "portsAttributes": {
    "8080": {"label": "Kafka UI"},
    "8082": {"label": "Spark master UI"},
    "9001": {"label": "MinIO console"},
    "8081": {"label": "Schema Registry"},
    "3000": {"label": "Grafana (Lab 10)"},
    "9090": {"label": "Prometheus (Lab 10)"},
    "4200": {"label": "Prefect UI (Lab 11)"}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
